# Application
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://vedai_user:vedai_password@localhost:5432/vedai?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OpenAI (for AI astrologer) - OPTIONAL for development
# Leave empty to use mock AI responses during development
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"

# File Storage - Uses LOCAL storage (no cloud needed for development)
# Files will be stored in ./uploads/ folder
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"

# Payment Gateway (Razorpay - India)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# SMS/OTP Provider (Optional - Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Email (Optional - SendGrid)
SENDGRID_API_KEY="SG..."
SENDGRID_FROM_EMAIL="noreply@vedai.com"
SENDGRID_FROM_NAME="VedAI"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/jpg"

# Admin Default Credentials (Change immediately!)
ADMIN_EMAIL="admin@vedai.com"
ADMIN_PASSWORD="Admin@123456"

# Feature Flags
ENABLE_CHAT=true
ENABLE_PALM_READING=true
ENABLE_PAYMENT=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Logging
LOG_LEVEL="debug"
