# Anthropic API Configuration
# Get your free API key from: https://console.anthropic.com/
# New users get $5 free credit!

ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Server Configuration
NODE_ENV=production
PORT=5000

# ===================================================
# IMPORTANT: How to get your Anthropic API Key
# ===================================================
# 1. Go to https://console.anthropic.com/
# 2. Sign up (FREE - includes $5 credit!)
# 3. Navigate to API Keys section
# 4. Click "Create Key"
# 5. Copy the key (starts with sk-ant-...)
# 6. Replace "your-api-key-here" above with your key
# 7. Save this file as .env (remove .example)
# 8. Restart the server: npm start
#
# Without API Key: App will use fallback responses (still works!)
# With API Key: Get real AI-powered chat and Kundli analysis
#
# Cost: ~$0.50-2/month for typical usage (Claude 3 Haiku model)
# Free credit lasts several months for personal use!
