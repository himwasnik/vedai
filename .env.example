# VedAI Environment Configuration

# ==========================================
# AWS BEDROCK CONFIGURATION (Required for AI)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Available Claude models on Bedrock:
# - anthropic.claude-3-sonnet-20240229-v1:0 (Balanced - Recommended)
# - anthropic.claude-3-haiku-20240307-v1:0 (Fast & economical)
# - anthropic.claude-3-opus-20240229-v1:0 (Most capable)

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=postgresql://vedai_user:vedai_password_2024@localhost:5432/vedai

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# AWS S3 STORAGE (Optional - for cloud storage)
# ==========================================
# AWS credentials above are used for S3 as well
AWS_BUCKET_NAME=vedai-uploads
AWS_S3_REGION=us-east-1

# ==========================================
# PAYMENT GATEWAY (Optional)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ==========================================
# CORS CONFIGURATION
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@vedai.com

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

# ==========================================
# ANTHROPIC API CONFIGURATION
# ==========================================
ANTHROPIC_API_KEY=
