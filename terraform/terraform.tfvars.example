# AWS Configuration
aws_region    = "ap-south-1"      # Change if needed (us-east-1, eu-west-1, etc)
instance_type = "t2.micro"        # Free tier eligible, or use t2.small for better performance
key_pair_name = "vedai-key"       # Change to your AWS EC2 key pair name

# Anthropic API Key - REPLACE WITH YOUR ACTUAL KEY
anthropic_key = "sk-ant-xxx"      # Get from https://console.anthropic.com

# Optional
root_volume_size = 30             # GB
